<Window x:Class="Checkers.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Checkers.Converters"
        xmlns:behaviors="clr-namespace:Checkers.Behaviors"
        Title="Шашки" Height="720" Width="720"
        ResizeMode="CanMinimize"
        Background="#1A0E07">

    <Window.Resources>
        <converters:PieceColorToBrushConverter x:Key="PieceColorToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Інформаційна панель -->
        <Grid DockPanel.Dock="Top" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Чорні -->
            <Border Grid.Column="0" Background="#2C1A0A" CornerRadius="8" Padding="12 8">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="24" Height="24" Fill="#1E1008" Margin="0 0 8 0"
                         Stroke="#555" StrokeThickness="1.5"/>
                        <TextBlock Foreground="Wheat" FontSize="16" VerticalAlignment="Center">
                    <Run Text="Чорні: "/>
                    <Run Text="{Binding BlackPieceCount, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Foreground="#AAA" FontSize="13" HorizontalAlignment="Center" Margin="0 4 0 0">
                <Run Text="Перемог: "/>
                <Run Text="{Binding BlackScore, Mode=OneWay}" FontWeight="Bold" Foreground="Wheat"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Центр: статус, таймер, кнопки -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="16 0">
                <TextBlock Text="{Binding StatusMessage}"
                   Foreground="Wheat" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TimerDisplay, Mode=OneWay}"
                   Foreground="#F4D03F" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0 4 0 0"
                   FontFamily="Consolas"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 6 0 0">
                    <Button Content="Нова гра" Command="{Binding NewGameCommand}"
                    Padding="10 5" FontSize="12"
                    Background="#8B4513" Foreground="Wheat"
                    BorderBrush="#5C2D0A" Cursor="Hand" Margin="0 0 4 0"/>
                    <Button Content="💾" Command="{Binding SaveGameCommand}"
                    Padding="10 5" FontSize="12" ToolTip="Зберегти гру"
                    Background="#2C6E49" Foreground="Wheat"
                    BorderBrush="#1B4332" Cursor="Hand" Margin="0 0 4 0"/>
                    <Button Content="📂" Command="{Binding LoadGameCommand}"
                    Padding="10 5" FontSize="12" ToolTip="Завантажити гру"
                    Background="#1A5276" Foreground="Wheat"
                    BorderBrush="#154360" Cursor="Hand"
                    IsEnabled="{Binding CanLoad, Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>

            <!-- Білі -->
            <Border Grid.Column="2" Background="#2C1A0A" CornerRadius="8" Padding="12 8">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="24" Height="24" Fill="#F0E6D2" Margin="0 0 8 0"
                         Stroke="#AAA" StrokeThickness="1.5"/>
                        <TextBlock Foreground="Wheat" FontSize="16" VerticalAlignment="Center">
                    <Run Text="Білі: "/>
                    <Run Text="{Binding WhitePieceCount, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Foreground="#AAA" FontSize="13" HorizontalAlignment="Center" Margin="0 4 0 0">
                <Run Text="Перемог: "/>
                <Run Text="{Binding WhiteScore, Mode=OneWay}" FontWeight="Bold" Foreground="Wheat"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Дошка + фігури -->
        <Grid x:Name="BoardContainer"
      Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">

            <!-- Клітинки дошки -->
            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="8" Columns="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F0E6D2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Background" Value="#5C3317"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#F4D03F"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter Property="Background" Value="#27AE60"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLastMoveFrom}" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLastMoveTo}" Value="True">
                                            <Setter Property="Background" Value="#1ABC9C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsForcedCapture}" Value="True">
                                            <Setter Property="BorderThickness" Value="3"/>
                                            <Setter Property="BorderBrush" Value="#E74C3C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Button Command="{Binding DataContext.CellClickCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                            <ContentPresenter/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Фігури на Canvas поверх дошки -->
            <ItemsControl ItemsSource="{Binding Pieces}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="behaviors:PieceAnimationBehavior.AnimatedX"
                                Value="{Binding X}"/>
                        <Setter Property="behaviors:PieceAnimationBehavior.AnimatedY"
                                Value="{Binding Y}"/>
                        <Setter Property="Width" Value="{Binding DataContext.CellSize,
                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        <Setter Property="Height" Value="{Binding DataContext.CellSize,
                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PieceScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PieceScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                From="0" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetName="PieceScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                From="0" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>

                            <Ellipse Margin="6"
                                     Fill="{Binding Color, Converter={StaticResource PieceColorToBrush}}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="StrokeThickness" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKing}" Value="True">
                                                <Setter Property="Stroke" Value="Gold"/>
                                                <Setter Property="StrokeThickness" Value="4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock Text="♛"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gold"
                                       Visibility="{Binding IsKing,
                                           Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</Window>