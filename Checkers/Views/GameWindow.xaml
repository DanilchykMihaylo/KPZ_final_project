<Window x:Class="Checkers.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Checkers.Converters"
        Title="Шашки" Height="620" Width="660"
        ResizeMode="CanMinimize"
        Background="#2B1A0E">

    <Window.Resources>
        <converters:PieceColorToBrushConverter x:Key="PieceColorToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:KingVisibilityConverter x:Key="KingToVisibility"/>
    </Window.Resources>

    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0 0 0 10">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="Wheat" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0 0 20 0"/>
            <Button Content="Нова гра" Command="{Binding NewGameCommand}"
                    Padding="12 6" FontSize="14"
                    Background="#8B4513" Foreground="Wheat"
                    BorderBrush="#5C2D0A" Cursor="Hand"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="8" Columns="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F0E6D2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDark}" Value="True">
                                        <Setter Property="Background" Value="#5C3317"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#F4D03F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="Background" Value="#27AE60"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button Command="{Binding DataContext.CellClickCommand,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>

                            <Grid HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">

                                <Ellipse Margin="6"
             Fill="{Binding Piece.Color, Converter={StaticResource PieceColorToBrush}}"
             Visibility="{Binding HasPiece, Converter={StaticResource BoolToVisibility}}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="StrokeThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PieceIsKing}" Value="True">
                                                    <Setter Property="Stroke" Value="Gold"/>
                                                    <Setter Property="StrokeThickness" Value="4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <TextBlock Text="♛"
               FontSize="20"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Foreground="Gold"
               IsHitTestVisible="False"
               Visibility="{Binding PieceIsKing, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Button>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>