<Window x:Class="Checkers.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Checkers.Converters"
        Title="Шашки" Height="680" Width="700"
        ResizeMode="CanMinimize"
        Background="#1A0E07">

    <Window.Resources>
        <converters:PieceColorToBrushConverter x:Key="PieceColorToBrush"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Інформаційна панель -->
        <Grid DockPanel.Dock="Top" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Чорні фігури -->
            <Border Grid.Column="0" Background="#2C1A0A" CornerRadius="8" Padding="12 8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="24" Height="24" Fill="#1E1008" Margin="0 0 8 0"
                 Stroke="#555" StrokeThickness="1.5"/>
                    <TextBlock Foreground="Wheat" FontSize="16" VerticalAlignment="Center">
            <Run Text="Чорні: "/>
            <Run Text="{Binding BlackPieceCount, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Статус + Нова гра -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Margin="16 0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Wheat" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <Button Content="Нова гра" Command="{Binding NewGameCommand}"
                        Margin="0 6 0 0" Padding="14 6" FontSize="13"
                        Background="#8B4513" Foreground="Wheat"
                        BorderBrush="#5C2D0A" Cursor="Hand"/>
            </StackPanel>

            <!-- Білі фігури -->
            <Border Grid.Column="2" Background="#2C1A0A" CornerRadius="8" Padding="12 8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="24" Height="24" Fill="#F0E6D2" Margin="0 0 8 0"
                 Stroke="#AAA" StrokeThickness="1.5"/>
                    <TextBlock Foreground="Wheat" FontSize="16" VerticalAlignment="Center">
            <Run Text="Білі: "/>
            <Run Text="{Binding WhitePieceCount, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Дошка -->
        <ItemsControl ItemsSource="{Binding Cells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="8" Columns="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#F0E6D2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDark}" Value="True">
                                        <Setter Property="Background" Value="#5C3317"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#F4D03F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="Background" Value="#27AE60"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLastMoveFrom}" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLastMoveTo}" Value="True">
                                        <Setter Property="Background" Value="#1ABC9C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsForcedCapture}" Value="True">
                                        <Setter Property="BorderThickness" Value="3"/>
                                        <Setter Property="BorderBrush" Value="#E74C3C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Button Command="{Binding DataContext.CellClickCommand,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Stretch"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>

                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                <Ellipse Margin="6"
                                         Fill="{Binding Piece.Color, Converter={StaticResource PieceColorToBrush}}"
                                         Visibility="{Binding HasPiece, Converter={StaticResource BoolToVisibility}}"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="StrokeThickness" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PieceIsKing}" Value="True">
                                                    <Setter Property="Stroke" Value="Gold"/>
                                                    <Setter Property="StrokeThickness" Value="4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <TextBlock Text="♛"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="Gold"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding PieceIsKing,
                                               Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Button>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>