<Window x:Class="Checkers.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Checkers.Converters"
        xmlns:behaviors="clr-namespace:Checkers.Behaviors"
        Title="Шашки" Height="760" Width="760"
        ResizeMode="CanMinimize"
        Background="{Binding BackgroundBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:PieceColorToBrushConverter x:Key="PieceColorToBrush"/>
        <converters:PieceColorToBoolConverter x:Key="PieceColorToBool"/>
        <converters:EqualToIntConverter x:Key="EqualToIntConverter"/>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Інформаційна панель -->
        <Grid DockPanel.Dock="Top" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{Binding PanelBrush}"
                    CornerRadius="8" Padding="12 8">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="24" Height="24"
                                 Fill="{Binding BlackPieceBrush}"
                                 Margin="0 0 8 0" Stroke="#555" StrokeThickness="1.5"/>
                        <TextBlock Foreground="Wheat" FontSize="16" VerticalAlignment="Center">
                            <Run Text="Чорні: "/>
                            <Run Text="{Binding BlackPieceCount, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Foreground="#AAA" FontSize="13"
                               HorizontalAlignment="Center" Margin="0 4 0 0">
                        <Run Text="Перемог: "/>
                        <Run Text="{Binding BlackScore, Mode=OneWay}"
                             FontWeight="Bold" Foreground="Wheat"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Margin="16 0">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="Wheat" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TimerDisplay, Mode=OneWay}"
                           Foreground="#F4D03F" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0 4 0 0"
                           FontFamily="Consolas"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0 6 0 0">
                    <Button Content="Нова гра" Command="{Binding NewGameCommand}"
                            Padding="8 5" FontSize="12"
                            Background="#8B4513" Foreground="Wheat"
                            BorderBrush="#5C2D0A" Cursor="Hand" Margin="0 0 4 0"/>
                    <Button Content="💾" Command="{Binding SaveGameCommand}"
                            Padding="8 5" FontSize="12" ToolTip="Зберегти гру"
                            Background="#2C6E49" Foreground="Wheat"
                            BorderBrush="#1B4332" Cursor="Hand" Margin="0 0 4 0"/>
                    <Button Content="📂" Command="{Binding LoadGameCommand}"
                            Padding="8 5" FontSize="12" ToolTip="Завантажити гру"
                            Background="#1A5276" Foreground="Wheat"
                            BorderBrush="#154360" Cursor="Hand" Margin="0 0 4 0"
                            IsEnabled="{Binding CanLoad, Mode=OneWay}"/>
                    <Button Content="⚙️" Command="{Binding OpenSettingsCommand}"
                            Padding="8 5" FontSize="12" ToolTip="Налаштування"
                            Background="#4A235A" Foreground="Wheat"
                            BorderBrush="#311B4A" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2" Background="{Binding PanelBrush}"
                    CornerRadius="8" Padding="12 8">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="24" Height="24"
                                 Fill="{Binding WhitePieceBrush}"
                                 Margin="0 0 8 0" Stroke="#AAA" StrokeThickness="1.5"/>
                        <TextBlock Foreground="Wheat" FontSize="16" VerticalAlignment="Center">
                            <Run Text="Білі: "/>
                            <Run Text="{Binding WhitePieceCount, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Foreground="#AAA" FontSize="13"
                               HorizontalAlignment="Center" Margin="0 4 0 0">
                        <Run Text="Перемог: "/>
                        <Run Text="{Binding WhiteScore, Mode=OneWay}"
                             FontWeight="Bold" Foreground="Wheat"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Дошка -->
        <Grid x:Name="BoardContainer"
              Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}">

            <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding DataContext.BoardSize,
                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     Columns="{Binding DataContext.BoardSize,
                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="{Binding DataContext.LightCellBrush,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{Binding DataContext.DarkCellBrush,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#F4D03F"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter Property="Background" Value="#27AE60"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLastMoveFrom}" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLastMoveTo}" Value="True">
                                            <Setter Property="Background" Value="#1ABC9C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsForcedCapture}" Value="True">
                                            <Setter Property="BorderThickness" Value="3"/>
                                            <Setter Property="BorderBrush" Value="#E74C3C"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Button Command="{Binding DataContext.CellClickCommand,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Pieces}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="behaviors:PieceAnimationBehavior.AnimatedX"
                                Value="{Binding X}"/>
                        <Setter Property="behaviors:PieceAnimationBehavior.AnimatedY"
                                Value="{Binding Y}"/>
                        <Setter Property="Width"
                                Value="{Binding DataContext.CellSize,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                        <Setter Property="Height"
                                Value="{Binding DataContext.CellSize,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PieceScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                Storyboard.TargetName="PieceScale"
                                Storyboard.TargetProperty="ScaleX"
                                From="0" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                Storyboard.TargetName="PieceScale"
                                Storyboard.TargetProperty="ScaleY"
                                From="0" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>

                            <Ellipse Margin="6"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="StrokeThickness" Value="0"/>
                                        <Setter Property="Fill"
                                Value="{Binding DataContext.WhitePieceBrush,
                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Color,
                                Converter={StaticResource PieceColorToBool}}"
                                         Value="True">
                                                <Setter Property="Fill"
                                        Value="{Binding DataContext.BlackPieceBrush,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKing}" Value="True">
                                                <Setter Property="Stroke" Value="Gold"/>
                                                <Setter Property="StrokeThickness" Value="4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock Text="♛"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="Gold"
                       IsHitTestVisible="False"
                       Visibility="{Binding IsKing,
                           Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</Window>