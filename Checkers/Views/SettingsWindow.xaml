<Window x:Class="Checkers.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Checkers.Converters"
        Title="Налаштування" Height="500" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A0E07">

    <Window.Resources>
        <converters:ThemePreviewConverter x:Key="ThemePreview"/>
    </Window.Resources>

    <StackPanel Margin="24">

        <TextBlock Text="Налаштування" Foreground="Wheat"
                   FontSize="20" FontWeight="Bold" Margin="0 0 0 24"/>

        
            

        <!-- Тема дошки -->
        <TextBlock Text="Тема дошки" Foreground="#AAA"
                   FontSize="13" Margin="0 0 0 8"/>

        <ListBox ItemsSource="{Binding AvailableThemes}"
                 SelectedItem="{Binding SelectedTheme}"
                 Background="Transparent"
                 BorderThickness="0"
                 Margin="0 0 0 24">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border BorderThickness="3" CornerRadius="6" Margin="0 0 8 0"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected,
                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                                             Value="True">
                                                    <Setter Property="BorderBrush" Value="#F4D03F"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="60" Height="60" Cursor="Hand">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0"
                                Background="{Binding Converter={StaticResource ThemePreview},
                                    ConverterParameter=light}"/>
                        <Border Grid.Row="0" Grid.Column="1"
                                Background="{Binding Converter={StaticResource ThemePreview},
                                    ConverterParameter=dark}"/>
                        <Border Grid.Row="1" Grid.Column="0"
                                Background="{Binding Converter={StaticResource ThemePreview},
                                    ConverterParameter=dark}"/>
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{Binding Converter={StaticResource ThemePreview},
                                    ConverterParameter=light}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Кнопки -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Скасувати" Command="{Binding CancelCommand}"
                    Padding="14 7" Margin="0 0 8 0"
                    Background="#3A2010" Foreground="Wheat"
                    BorderBrush="#5C3317" Cursor="Hand"/>
            <Button Content="Застосувати" Command="{Binding ApplyCommand}"
                    Padding="14 7"
                    Background="#8B4513" Foreground="Wheat"
                    BorderBrush="#5C2D0A" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>